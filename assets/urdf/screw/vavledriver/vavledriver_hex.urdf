<?xml version="1.0"?>
<!-- Fixed-axis valve task. The rotating handle is a regular hexagonal prism:
     circumradius 35 mm, across-flats 60.62 mm, height 80 mm.
     Mesh hex_valve.stl is authored at 30 mm; XY scale 7/6 maps it to 35 mm. -->
<robot name="vavledriver">
  <link name="base">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.01"/></geometry>
      <material name="base_gray"><color rgba="0.55 0.55 0.55 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.02508" ixy="0" ixz="0" iyy="0.02508" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <link name="shaft">
    <visual>
      <origin xyz="0 0 0.01"/>
      <geometry><cylinder radius="0.008" length="0.02"/></geometry>
      <material name="shaft_dark"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.01"/>
      <geometry><cylinder radius="0.008" length="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.012"/>
      <origin xyz="0 0 0.01"/>
      <inertia ixx="0.000000528" ixy="0" ixz="0" iyy="0.000000528" iyz="0" izz="0.000000384"/>
    </inertial>
  </link>

  <link name="valve">
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><mesh filename="hex_valve.stl" scale="1.1666666666666667 1.1666666666666667 1.0"/></geometry>
      <material name="valve_blue"><color rgba="0.10 0.35 0.80 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04"/>
      <geometry><mesh filename="hex_valve.stl" scale="1.1666666666666667 1.1666666666666667 1.0"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.04"/>
      <inertia ixx="0.000036042" ixy="0" ixz="0" iyy="0.000036042" iyz="0" izz="0.000018750"/>
    </inertial>
    <!-- Asymmetric visual marker makes rotation easy to inspect in the viewer. -->
    <visual>
      <origin xyz="0.014 0 0.0805"/>
      <geometry><box size="0.018 0.004 0.001"/></geometry>
      <material name="marker_red"><color rgba="0.95 0.10 0.10 1"/></material>
    </visual>
  </link>

  <joint name="base_to_shaft" type="fixed">
    <parent link="base"/>
    <child link="shaft"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="valve_to_shaft" type="revolute">
    <parent link="shaft"/>
    <child link="valve"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <dynamics friction="0.2"/>
    <limit lower="0.0" upper="628.3185" effort="2.0" velocity="6.2832"/>
  </joint>
</robot>
