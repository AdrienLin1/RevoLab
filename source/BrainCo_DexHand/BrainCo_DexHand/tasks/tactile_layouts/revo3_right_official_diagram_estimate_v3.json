  "conversion": {
    "image_to_finger_xy": "project source-center offsets onto each estimated distal/lateral image direction, then scale the projected calibration ROI to finger_x=+-0.009 m and finger_y=+-0.007 m",
    "finger_xy_to_sensor_plane": "the Revo3 gel u axis is fingertip lateral and gel v is fingertip longitudinal, so runtime uses u=finger_y and v=finger_x",
    "runtime_representation": "each cell of the unchanged 16x16 TacSL tensor is snapped in finger coordinates to its nearest estimated center, then transformed into the gel sensor plane"
  },
  "notes": [
    "Version 3 applies only a uniform +1.0 mm fingertip-direction offset to all five v2 layouts.",
    "Circle centers and finger directions were estimated from the supplied screenshots and are not millimetre-accurate calibration data.",
    "Version 2 corrects the v1 assumption that the first gel-grid axis is the fingertip longitudinal axis.",
    "Version 1 remains unchanged for traceability; do not overwrite either version when measured coordinates become available.",
    "official_sensor_id is the number printed in each per-finger screenshot, not a verified hardware channel id."
  ],
