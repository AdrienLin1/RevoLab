    "finger_y": "finger lateral axis; positive follows source_lateral_direction_image_uv",
    "sensor_plane_uv": "gel mesh in-plane axes; [u,v]^T = sensor_plane_from_finger_xy * [finger_x,finger_y]^T",
    "normal": "not stored; generated by the existing fingertip surface projection"
